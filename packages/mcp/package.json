{
  "name": "@perfagent/mcp",
  "version": "0.1.0",
  "description": "PerfAgent as an MCP server (stdio for Claude Code / Cursor / Copilot / Windsurf, Streamable HTTP for ChatGPT and teams). Read-only tools by default.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": { "build": "tsc -b", "typecheck": "tsc --noEmit -p tsconfig.json" },
  "dependencies": {
    "@perfagent/config": "workspace:*",
    "@perfagent/core": "workspace:*",
    "@perfagent/engine": "workspace:*",
    "@perfagent/security": "workspace:*"
  }
}
