{
  "name": "@perfagent/web",
  "version": "0.1.0",
  "private": true,
  "description": "PerfAgent dashboard: globe, deep dive, flow diagram, charts, compare, guide, live and settings.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "VITE_PERFAGENT_STATIC=1 vite build --outDir dist-static && node scripts/static-assets.mjs",
    "preview:static": "vite preview --outDir dist-static --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "PERFAGENT_GUIDES_DIR=e2e/fixtures/guides pnpm run build:static && playwright test"
  },
  "dependencies": {
    "@perfagent/core": "workspace:*",
    "@perfagent/report-schema": "workspace:*",
    "@xyflow/react": "12.12.1",
    "dompurify": "3.4.18",
    "driver.js": "1.14.0",
    "echarts": "6.1.0",
    "elkjs": "0.12.1",
    "html-to-image": "1.11.13",
    "marked": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "three": "0.185.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "5.1.1",
    "jsdom": "26.1.0",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  }
}
